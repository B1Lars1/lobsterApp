// Tilgangsregler for Firestore i Firebase-prosjektet lobsterapp-aee59.
//
// Legges inn for hånd: Firebase-konsollen → Firestore Database → Rules → lim inn hele
// filen → Publish. Endres de her, må de limes inn på nytt.
//
// brukere/{uid}/markeringer/{id}   brukerens egne markeringer. Bare brukeren selv.
// lag/{kode}                       et lag: { navn, medlemmer: [uid], eposter: { uid: e-post }, opprettet,
//                                  initialer: { uid: «BL» } }
// lag/{kode}/markeringer/{id}      lagets felles markeringer. Alle medlemmene.
// Koden (8 tegn) er dokument-id-en og fungerer som invitasjon: den som kjenner den,
// kan legge seg selv til som medlem. Hver kan bare sette sine egne initialer og skrive sin
// egen e-post. Markeringene i laget kan bare slettes helt av det siste medlemmet (når laget
// slettes). Ellers er en sletting et dokument med slettet: true. Alt annet er stengt.
// Se app/js/sky.js og firebase.js.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function innlogget() {
      return request.auth != null;
    }

    // En markering (teine eller fangst), eller en sletting (slettet: true).
    // Id-en er en UUID fra appen; andre tegn kunne blitt til HTML hos de andre i laget.
    // Feltene er FELT i app/js/markeringer.js pluss lat, lon, slettet og oppdatert. Et nytt
    // felt må legges til her, og reglene publiseres før appen.
    function gyldigMarkering(id) {
      let d = request.resource.data;
      return d.id == id
        && id.matches('^[A-Za-z0-9_-]{1,100}$')
        && d.keys().hasOnly(['id', 'kategori', 'tid', 'endret', 'notat', 'dybde', 'noyaktighet',
             'kilde', 'nummer', 'status', 'tatt_opp', 'beholdt', 'satt_ut', 'teine_id',
             'registrert_av', 'mistet', 'lat', 'lon', 'slettet', 'oppdatert'])
        && d.endret is string && d.endret.size() <= 40
        && d.slettet is bool
        && d.oppdatert == request.time      // settes av serveren (serverTimestamp)
        && (d.slettet
            || (d.kategori in ['teine', 'hummer'] && d.lat is number && d.lon is number))
        && (!('notat' in d) || d.notat == null || (d.notat is string && d.notat.size() <= 2000))
        && (!('registrert_av' in d) || d.registrert_av == null
            || (d.registrert_av is string && d.registrert_av.size() <= 128));
    }

    match /brukere/{uid}/markeringer/{id} {
      allow read, delete: if innlogget() && request.auth.uid == uid;
      allow create, update: if innlogget() && request.auth.uid == uid && gyldigMarkering(id);
    }

    match /lag/{kode} {
      function erMedlem() {
        return innlogget() && request.auth.uid in resource.data.medlemmer;
      }

      // Initialene: du kan legge til, endre og fjerne dine egne. Den som fjerner et medlem,
      // kan også fjerne medlemmets initialer. 1–3 store bokstaver (samme regel som i appen).
      function initialerOk() {
        let foer = resource.data.get('initialer', {});
        let etter = request.resource.data.get('initialer', {});
        let endring = etter.diff(foer);
        let fjernede = resource.data.medlemmer.toSet().difference(request.resource.data.medlemmer.toSet());
        return endring.addedKeys().union(endring.changedKeys()).hasOnly([request.auth.uid])
          && endring.removedKeys().hasOnly(fjernede.union([request.auth.uid].toSet()))
          && (!(request.auth.uid in etter)
              || (etter[request.auth.uid] is string && etter[request.auth.uid].matches('^[A-ZÆØÅ]{1,3}$')));
      }

      // E-postene: et medlem kan ikke legge til eller endre noens e-post, bare fjerne
      // e-posten til dem som fjernes fra laget. Den eneste som skriver en e-post, er den som
      // blir med (eller oppretter laget), med sin egen.
      function eposterOk() {
        let endring = request.resource.data.eposter.diff(resource.data.eposter);
        let fjernede = resource.data.medlemmer.toSet().difference(request.resource.data.medlemmer.toSet());
        return endring.addedKeys().size() == 0 && endring.changedKeys().size() == 0
          && endring.removedKeys().hasOnly(fjernede);
      }

      allow read: if erMedlem();

      // Opprett: du er eneste medlem
      allow create: if innlogget()
        && kode.size() == 8
        && request.resource.data.keys().hasOnly(['navn', 'medlemmer', 'eposter', 'opprettet'])
        && request.resource.data.navn is string
        && request.resource.data.navn.size() > 0 && request.resource.data.navn.size() <= 40
        && request.resource.data.medlemmer == [request.auth.uid]
        && request.resource.data.eposter.keys().hasOnly([request.auth.uid])
        && request.resource.data.eposter[request.auth.uid] == request.auth.token.email
        && request.resource.data.opprettet == request.time;

      allow update: if innlogget()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['navn', 'medlemmer', 'eposter', 'initialer'])
        && initialerOk()
        && request.resource.data.medlemmer.size() <= 20
        && request.resource.data.navn is string
        && request.resource.data.navn.size() > 0 && request.resource.data.navn.size() <= 40
        && (
          // Bli med: legger bare til deg selv, med din egen e-post (krever at du kjenner koden)
          (request.resource.data.medlemmer.hasAll(resource.data.medlemmer)
            && request.resource.data.medlemmer.removeAll(resource.data.medlemmer) == [request.auth.uid]
            && request.resource.data.eposter.diff(resource.data.eposter).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.eposter[request.auth.uid] == request.auth.token.email
            && request.resource.data.navn == resource.data.navn)
          // Medlem: kan endre navnet og fjerne medlemmer (også seg selv), men ikke legge til andre
          || (erMedlem() && resource.data.medlemmer.hasAll(request.resource.data.medlemmer)
              && eposterOk())
        );

      // Slett laget: bare når du er det siste medlemmet
      allow delete: if innlogget() && resource.data.medlemmer == [request.auth.uid];

      match /markeringer/{id} {
        function medlemmene() {
          return get(/databases/$(database)/documents/lag/$(kode)).data.medlemmer;
        }
        function medlemILaget() {
          return innlogget() && request.auth.uid in medlemmene();
        }
        allow read: if medlemILaget();
        // Slette dokumenter helt kan bare det siste medlemmet, rett før laget slettes
        // (fjernMedlem i firebase.js). En slik sletting når ikke de andre telefonene, og den
        // inkrementelle sikkerhetskopien ser den ikke.
        allow delete: if innlogget() && medlemmene() == [request.auth.uid];
        allow create, update: if medlemILaget() && gyldigMarkering(id);
      }
    }
  }
}
